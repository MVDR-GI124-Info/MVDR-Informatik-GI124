#include <Encoder.h>

Encoder myEnc(20, 21);

const int directionPin = 12;
const int pwmPin = 3;

// Encoder
long eV1 = 0;
long eV2 = 0;

// Zeit
unsigned long T1 = 0;
unsigned long T2 = 0;

// Sollposition (30 cm Seil)
const long targetPosition = 1375;

// Positionsregler
float Kpos = 0.05;

// Drehzahl-PID
float Kp = 0.1;
float Ki = 0.1;
float Kd = 0.01;

float integral = 0;
float lastError = 0;

// Stellgröße
float motorPower = 0;

void setup()
{
    pinMode(directionPin, OUTPUT);
    pinMode(pwmPin, OUTPUT);

    Serial.begin(115200);

    myEnc.write(0);

    T1 = millis();
    T2 = millis();
}

void loop()
{
    T1 = T2;
    T2 = millis();

    eV1 = eV2;
    eV2 = myEnc.read();

    float speed = calculateSpeed(
        eV1,
        eV2,
        T1,
        T2);

    float dt = (T2 - T1) / 1000.0;

    if (dt <= 0)
        return;

    // ===== POSITION =====

    long position = eV2;

    long positionError =
        targetPosition - position;

    // Ziel erreicht?
    if (abs(positionError) < 5)
    {
        setPower(0);

        Serial.print("Position erreicht: ");
        Serial.println(position);

        return;
    }

    // Positionsfehler -> Soll-Drehzahl
    float targetSpeed =
        Kpos * positionError;

    targetSpeed =
        constrain(
            targetSpeed,
            -80,
             80);

    // ===== DREHZAHL PID =====

    float speedError =
        targetSpeed - speed;

    integral += speedError * dt;

    integral =
        constrain(
            integral,
            -500,
             500);

    float derivative =
        (speedError - lastError) / dt;

    float control =
        Kp * speedError +
        Ki * integral +
        Kd * derivative;

    motorPower += control;

    motorPower =
        constrain(
            motorPower,
            -100,
             100);

    setPower(motorPower);

    lastError = speedError;

    // ===== DEBUG =====

    Serial.print("Pos: ");
    Serial.print(position);

    Serial.print("  Fehler: ");
    Serial.print(positionError);

    Serial.print("  SollRPM: ");
    Serial.print(targetSpeed);

    Serial.print("  RPM: ");
    Serial.print(speed);

    Serial.print("  Power: ");
    Serial.println(motorPower);
}

float calculateSpeed(
    long encoderValueT1,
    long encoderValueT2,
    unsigned long timeT1,
    unsigned long timeT2)
{
    if (timeT2 == timeT1)
        return 0;

    float deltaEncoderValue =
        (encoderValueT2 - encoderValueT1) / 720.0;

    float deltaT =
        (timeT2 - timeT1) / 60000.0;

    return deltaEncoderValue / deltaT;
}

void setPower(float power)
{
    power =
        constrain(
            power,
            -100,
             100);

    if (power >= 0)
    {
        digitalWrite(directionPin, HIGH);
    }
    else
    {
        digitalWrite(directionPin, LOW);
    }

    int pwmValue =
        abs(power) * 2.55;

    analogWrite(
        pwmPin,
        pwmValue);
}
